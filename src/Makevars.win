# --- TMB inline compilation for webR compatibility (Windows) ---
#
# This Makevars compiles TMB code inline as part of the main package library,
# following the approach used by glmmTMB. This avoids the TMB::compile() step
# that fails during cross-compilation for WebAssembly.

# TMB configuration
PKG_CPPFLAGS = -DSTRICT_R_HEADERS -DTMBAD_FRAMEWORK

# Libraries and flags
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(SHLIB_OPENMP_CXXFLAGS)
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

# Object files - TMB exports compiled inline as part of main library
OBJECTS = detfuns.o distprob.o distr.o get_lik_trans.o get_mlogit.o \
          nll_distsamp.o nll_distsampOpen.o nll_gdistremoval.o \
          nll_gdistsamp.o nll_gmultmix.o nll_gpcount.o nll_multinomPois.o \
          nll_multmixOpen.o nll_nmixTTD.o nll_occu.o nll_occuCOP.o \
          nll_occuMS.o nll_occuMulti.o nll_occuPEN.o nll_occuRN.o \
          nll_occuTTD.o nll_pcount.o nll_pcountOpen.o pifun.o \
          RcppExports.o tranprobs.o utils.o unmarked_TMBExports.o
